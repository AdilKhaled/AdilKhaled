# Copy to .env and edit before first run:  cp .env.example .env

# Initial dashboard admin password. CHANGE THIS before first boot.
# Only used on first boot; afterwards change it in Dashboard -> Settings -> Security.
INITIAL_PASSWORD=CHANGEME

# Server port inside the container / on the host.
PORT=20128

# Node.js heap size in MB. 1024 is the image default; use 8192 for a coding agent.
OMNIROUTE_MEMORY_MB=1024

# Optional secrets. Leave empty and OmniRoute generates and stores them under DATA_DIR on first boot.
# Generate: openssl rand -base64 48
JWT_SECRET=
# Generate: openssl rand -hex 32
API_KEY_SECRET=
# Optional SQLite encryption at rest. Generate: openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
